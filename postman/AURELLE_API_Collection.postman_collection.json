{
  "info": {
    "name": "AURELLE API v1.0",
    "_postman_id": "aurelle-api-collection-v1",
    "description": "Complete API testing collection for AURELLE Beauty Salon Platform.\n\n**Features:**\n- 80+ API endpoints\n- 7 organized modules\n- Automated test assertions\n- Pre-request authentication\n- Environment variables support\n\n**Modules:**\n1. Auth - Authentication & Registration\n2. Salons - Salon CRUD & Public endpoints\n3. Masters - Master profiles & Availability\n4. Services - Service management\n5. Bookings - Booking creation & Management\n6. Reviews - Review system\n7. Admin - Platform administration\n\n**Quick Start:**\n1. Import this collection\n2. Import environment (Development/Staging/Production)\n3. Set user_email and user_password in environment\n4. Run collection or individual requests\n\n**Documentation:** See API_TESTING_POSTMAN_GUIDE.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global Pre-Request Script",
          "// Tracks request start time for performance testing",
          "pm.environment.set('request_start_time', Date.now());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global Test Script",
          "// These tests run for ALL requests",
          "",
          "// 1. Check response time",
          "const requestStart = parseInt(pm.environment.get('request_start_time') || '0');",
          "const requestDuration = Date.now() - requestStart;",
          "",
          "pm.test('⏱️ Response time is acceptable', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// 2. No server errors",
          "pm.test('✅ No server errors (5xx)', function () {",
          "    pm.expect(pm.response.code).to.not.be.oneOf([500, 502, 503, 504]);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01. Auth",
      "description": "Authentication and authorization endpoints",
      "item": [
        {
          "name": "Get Auth Providers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base}}/auth/providers",
              "host": ["{{api_base}}"],
              "path": ["auth", "providers"]
            },
            "description": "Get available authentication providers (Google, Yandex, GitHub, Phone)"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Providers object is valid', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('local');",
                  "    pm.expect(jsonData).to.have.property('google');",
                  "    pm.expect(jsonData.local).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test('Response time < 300ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(300);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (Email/Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": {
              "raw": "{{api_base}}/auth/login",
              "host": ["{{api_base}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with email and password. Saves auth token to environment."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Login successful - Token received', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
                  "    ",
                  "    // Save auth token for subsequent requests",
                  "    pm.environment.set('auth_token', jsonData.token);",
                  "    pm.environment.set('token_timestamp', new Date().toISOString());",
                  "    console.log('✅ Auth token saved');",
                  "});",
                  "",
                  "pm.test('User data is valid', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('user');",
                  "    pm.expect(jsonData.user).to.have.property('id');",
                  "    pm.expect(jsonData.user).to.have.property('email');",
                  "    ",
                  "    // Save user ID",
                  "    pm.environment.set('user_id', jsonData.user.id);",
                  "});",
                  "",
                  "pm.test('Response time < 1000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{api_base}}/auth/user",
              "host": ["{{api_base}}"],
              "path": ["auth", "user"]
            },
            "description": "Get currently authenticated user details"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('User data is complete', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('email');",
                  "    pm.expect(jsonData).to.have.property('firstName');",
                  "    pm.expect(jsonData).to.have.property('isAdmin');",
                  "});",
                  "",
                  "pm.test('Response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{api_base}}/logout",
              "host": ["{{api_base}}"],
              "path": ["logout"]
            },
            "description": "Logout current user and clear session"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Logout successful', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    ",
                  "    // Clear auth token",
                  "    pm.environment.unset('auth_token');",
                  "    pm.environment.unset('user_id');",
                  "    pm.environment.unset('token_timestamp');",
                  "    console.log('✅ Auth token cleared');",
                  "});",
                  "",
                  "pm.test('Response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
