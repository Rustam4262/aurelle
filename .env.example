# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/aurelle

# Session Secret (min 32 characters for security)
SESSION_SECRET=your-super-secret-session-key-min-32-chars-long-change-this

# OAuth Providers (all optional)
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Yandex OAuth
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Phone Authentication (SMS via Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SERVICE_SID=your-twilio-verify-service-sid

# Yandex Maps API Key (for map display on homepage)
# Get API key from: https://developer.tech.yandex.ru/
VITE_YANDEX_MAPS_API_KEY=your-yandex-maps-api-key

# Email Configuration (SMTP)
# For Gmail: smtp.gmail.com, port 587, secure: false
# For SendGrid: smtp.sendgrid.net, port 587, secure: false
# For Mailgun: smtp.mailgun.org, port 587, secure: false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=AURELLE <noreply@aurelle.uz>

# Application URL (for email links)
APP_URL=https://aurelle.uz

# Environment
NODE_ENV=development
PORT=5000

# Sentry Error Monitoring (Optional)
# Get your DSN from: https://sentry.io/settings/projects/
# Backend Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=aurelle@1.0.0

# Frontend Sentry (for Vite)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=aurelle@1.0.0
VITE_APP_VERSION=1.0.0

# Sentry Source Maps Upload (for CI/CD)
# Create auth token: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-organization-slug
SENTRY_PROJECT=your-project-slug

# Optional: Force enable Sentry in development
# SENTRY_FORCE_ENABLE=true
# VITE_SENTRY_FORCE_ENABLE=true
