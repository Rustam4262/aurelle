# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/aurelle

# Session Secret (min 32 characters for security)
SESSION_SECRET=your-super-secret-session-key-min-32-chars-long-change-this

# OAuth Providers (all optional)
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Yandex OAuth
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Phone Authentication (SMS OTP via Twilio Verify)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SERVICE_SID=your-twilio-verify-service-sid

# SMS Notifications (booking events via Twilio Messages API)
# Separate from OTP: TWILIO_FROM is your notification sender number
SMS_ENABLED=true
TWILIO_FROM=+1234567890

# Web Push / VAPID Keys (for browser push notifications)
# Generate once with: npx web-push generate-vapid-keys
# Then copy the output into the three vars below and keep them in your password manager.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@aurelle.uz

# Yandex Maps API Key (for map display on homepage)
# Get API key from: https://developer.tech.yandex.ru/
VITE_YANDEX_MAPS_API_KEY=your-yandex-maps-api-key

# Email Configuration (SMTP)
# Keys read by server/config/email.ts — use EMAIL_* not SMTP_*
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords (requires 2FA)
# For SendGrid: smtp.sendgrid.net, port 587, EMAIL_SECURE=false, EMAIL_REQUIRE_TLS=true
# For Mailgun: smtp.mailgun.org, port 587
# Test config: TO_EMAIL=you@example.com tsx scripts/test-email.ts
# Health check: GET /api/health/email
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# EMAIL_SECURE=false       # true forces TLS from connection start (port 465). Default: auto (true if port 465)
# EMAIL_REQUIRE_TLS=true   # Upgrade to TLS via STARTTLS. Default: true
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=AURELLE <noreply@aurelle.uz>

# Application URL (for email links)
APP_URL=https://aurelle.uz

# Environment
NODE_ENV=development
PORT=5000

# Sentry Error Monitoring (Optional)
# Get your DSN from: https://sentry.io/settings/projects/
# Backend Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=aurelle@1.0.0

# Frontend Sentry (for Vite)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=aurelle@1.0.0
VITE_APP_VERSION=1.0.0

# Sentry Source Maps Upload (for CI/CD)
# Create auth token: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-organization-slug
SENTRY_PROJECT=your-project-slug

# Feature Flags (default: false - all new features disabled until explicitly enabled)
# Phase 7: Analytics Enhancements
FEAT_ENHANCED_ANALYTICS=false

# Phase 8: Bookings Management
FEAT_BOOKING_RESCHEDULE=false
FEAT_MANUAL_BOOKING=false

# Phase 9: Services & Masters
FEAT_BULK_SERVICE_UPDATE=false
FEAT_MASTER_SCHEDULE=false

# Phase 10: Calendar & Working Hours
FEAT_ENHANCED_CALENDAR=false
FEAT_WORKING_HOURS_BREAKS=false

# Phase 11: RBAC - Salon Manager
FEAT_SALON_MANAGER=false

# Additional Features
FEAT_EXPORT_EXCEL=false
FEAT_EXPORT_PDF=false

# Optional: Force enable Sentry in development
# SENTRY_FORCE_ENABLE=true
# VITE_SENTRY_FORCE_ENABLE=true

# Seed route protection (required to use /api/admin/seed/* in production)
# Generate with: openssl rand -hex 32
SEED_TOKEN=
