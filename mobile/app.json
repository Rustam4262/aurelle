{
  "expo": {
    "name": "Aurelle",
    "slug": "aurelle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#C81D60"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.aurelle.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C81D60"
      },
      "package": "uz.aurelle.app",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C81D60"
        }
      ],
      "expo-asset",
      "expo-localization"
    ],
    "extra": {
      "apiBaseUrl": "https://aurelle.uz",
      "eas": {
        "projectId": "b6eaf528-5b79-4145-befb-c80f7b93c63c"
      }
    }
  }
}
