{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Setup Demo Data",
			"type": "shell",
			"command": "${workspaceFolder}/node_modules/.bin/tsx",
			"args": [
				"server/setup-demo.ts"
			],
			"group": "test"
		},
		{
			"label": "Dev Server",
